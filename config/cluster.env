# Shared cluster identity
CONTROLLER_NAME="slurm-controller"
WORKER1_NAME="slurm-worker1"
WORKER2_NAME="slurm-worker2"

# Shared runtime settings
# Relative paths are resolved from the project root.
LOG_DIR="logs"

# Module 01: VM image and resources
UBUNTU_IMAGE="24.04"

CONTROLLER_CPUS="2"
CONTROLLER_MEMORY="1G"
CONTROLLER_DISK="8G"

WORKER1_CPUS="2"
WORKER1_MEMORY="1500M"
WORKER1_DISK="8G"

WORKER2_CPUS="2"
WORKER2_MEMORY="1500M"
WORKER2_DISK="8G"

# Module 02: operating-system and network verification
EXPECTED_OS_ID="ubuntu"
EXPECTED_VERSION_ID="24.04"
PING_COUNT="2"
MAX_CLOCK_SKEW_SECONDS="5"
REQUIRE_NTP_SYNC="true"

# Module 03: software installation
CONTROLLER_PACKAGES="munge slurmctld slurm-client"
WORKER_PACKAGES="munge slurmd slurm-client"
APT_UPDATE="true"

# Module 04: Slurm configuration
CLUSTER_NAME="slurm-lab"
PARTITION_NAME="debug"
# Keep this much RAM unconfigured for the guest operating system.
MEMORY_RESERVE_MB="16"
NODE_REGISTRATION_TIMEOUT_SECONDS="90"

# Module 05: end-to-end job validation
JOB_TIMEOUT_SECONDS="120"

# Module 06: shared NFS storage
SHARED_STORAGE_PATH="/shared"
NFS_CONTROLLER_PACKAGES="nfs-kernel-server"
NFS_WORKER_PACKAGES="nfs-common"

# Module 07: job arrays and dependencies
ARRAY_DEMO_DIR="/shared/arrays-demo"
ARRAY_TASK_COUNT="5"
ARRAY_JOB_TIMEOUT_SECONDS="180"

# Module 08: resource-constrained pending jobs
RESOURCE_PENDING_TIMEOUT_SECONDS="180"
RESOURCE_PENDING_BLOCKER_SLEEP_SECONDS="180"

# Module 09: node drain, failure, recovery, and resume
NODE_RECOVERY_TIMEOUT_SECONDS="60"
NODE_DRAIN_REASON="lesson-drain"
NODE_FAILURE_REASON="lesson-failure"

# Module 10: Slurm accounting database
ACCOUNTING_PACKAGES="mariadb-server slurmdbd"
ACCOUNTING_DB_NAME="slurm_acct_db"
ACCOUNTING_DB_USER="slurm"
ACCOUNTING_DB_AUTH_FILE="/etc/slurm/slurmdbd-mysql.auth"
ACCOUNTING_ACCOUNT="lab"
ACCOUNTING_DEMO_USER="ubuntu"
ACCOUNTING_TEST_DIR="/shared/accounting-lab"
ACCOUNTING_JOB_TIMEOUT_SECONDS="180"
